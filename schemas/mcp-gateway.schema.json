{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenKedge MCP gateway tool payloads",
  "$defs": {
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["instanceId", "skipOsShutdown"],
      "properties": {
        "instanceId": { "type": "string", "pattern": "^i-[a-f0-9]{17}$" },
        "skipOsShutdown": { "type": "boolean" },
        "reason": { "type": "string", "maxLength": 2000 },
        "memory": { "type": "string", "maxLength": 4000 }
      }
    },
    "actual": {
      "type": "object", "additionalProperties": false,
      "required": ["instanceId", "skipOsShutdown"],
      "properties": {
        "instanceId": { "type": "string", "pattern": "^i-[a-f0-9]{17}$" },
        "skipOsShutdown": { "type": "boolean" }
      }
    },
    "decision": {
      "oneOf": [
        { "type": "object", "additionalProperties": false,
          "required": ["status", "intentId", "policyVersion", "reasons", "grant"],
          "properties": { "status": { "const": "allowed" }, "intentId": { "type": "string" },
            "policyVersion": { "type": "string" }, "reasons": { "type": "array", "items": { "type": "string" } },
            "grant": { "$ref": "execution-contract.schema.json" } } },
        { "type": "object", "additionalProperties": false,
          "required": ["status", "intentId", "reasons", "code"],
          "properties": { "status": { "enum": ["denied", "remediation_required"] }, "intentId": { "type": "string" },
            "policyVersion": { "type": "string" }, "reasons": { "type": "array", "items": { "type": "string" } },
            "code": { "type": "string" } } }
      ]
    },
    "executionResult": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "intentId"],
      "properties": { "status": { "enum": ["executed", "rejected", "failed", "uncertain"] },
        "intentId": { "type": "string" }, "policyVersion": { "type": "string" },
        "code": { "type": "string" }, "reason": { "type": "string" }, "result": {} }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "version", "allowedInstanceIds", "protectedInstanceIds", "allowSkipOsShutdown", "instances", "rules"],
      "properties": { "protocolVersion": { "const": 1 }, "version": { "type": "string", "minLength": 1 },
        "allowedInstanceIds": { "type": "array", "items": { "type": "string" } },
        "protectedInstanceIds": { "type": "array", "items": { "type": "string" } },
        "allowSkipOsShutdown": { "type": "boolean" },
        "instances": { "type": "object", "additionalProperties": { "type": "object", "required": ["state", "tags"],
          "properties": { "state": { "type": "string" }, "tags": { "type": "object", "additionalProperties": { "type": "string" } } } } },
        "rules": { "type": "array", "items": { "$ref": "temporal-rule.schema.json" } } }
    }
  }
}
