{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Declarative Temporal Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "targetAction",
    "windowMs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "SLIDING_WINDOW_QUOTA",
        "RATE_LIMIT",
        "PRECEDING_EVENT_REQUIRED"
      ]
    },
    "targetAction": {
      "type": "string",
      "minLength": 1
    },
    "windowMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "scope": {
      "enum": [
        "ACTOR",
        "GLOBAL",
        "RESOURCE"
      ]
    },
    "resourcePath": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "metricPath": {
      "type": "string",
      "minLength": 1
    },
    "maxCumulativeValue": {
      "type": "number",
      "minimum": 0
    },
    "maxCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requiredPrecedingAction": {
      "type": "string",
      "minLength": 1
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currentPath",
          "historicalPath"
        ],
        "properties": {
          "currentPath": {
            "type": "string",
            "minLength": 1
          },
          "historicalPath": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "SLIDING_WINDOW_QUOTA"
        }
      },
      "required": [
        "metricPath",
        "maxCumulativeValue"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "RATE_LIMIT"
        }
      },
      "required": [
        "maxCount"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "PRECEDING_EVENT_REQUIRED"
        }
      },
      "required": [
        "requiredPrecedingAction"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "RESOURCE"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "required": [
          "resourcePath"
        ]
      }
    }
  ]
}
