{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Capability Attenuation Token",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tokenId",
    "sourceProposalId",
    "sourceHash",
    "issuedAt",
    "expiresAt",
    "actorId",
    "boundAttributes",
    "signature"
  ],
  "properties": {
    "tokenId": {
      "type": "string",
      "minLength": 1
    },
    "sourceProposalId": {
      "type": "string",
      "minLength": 1
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actorId": {
      "type": "string",
      "minLength": 1
    },
    "boundAttributes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
