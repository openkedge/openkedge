{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Runtime Execution Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "payload",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "payload": {},
    "kind": {
      "enum": [
        "READ",
        "PROBE",
        "MUTATION"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "actor",
        "timestamp"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "capability-token.schema.json"
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "temporalBounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxDurationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
