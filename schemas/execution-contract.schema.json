{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Temporal Execution Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "proposalId",
    "actorId",
    "action",
    "intentHash",
    "issuedAt",
    "temporalBounds",
    "temporalValidity",
    "linkedCapabilities",
    "capabilities",
    "preconditionHashes",
    "signature"
  ],
  "properties": {
    "contractId": {
      "type": "string",
      "minLength": 1
    },
    "proposalId": {
      "type": "string",
      "minLength": 1
    },
    "actorId": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "intentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "temporalBounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxDurationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "notBefore",
        "notAfter",
        "maxDurationMs"
      ]
    },
    "temporalValidity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validAfter",
        "validBefore"
      ],
      "properties": {
        "validAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "validBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "linkedCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "capability-token.schema.json"
      }
    },
    "preconditionHashes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
